@echo off
REM ── RunMyWork advisor — Windows launcher ──────────────────────────
REM Copy this file to "run-advisor.bat" (which is gitignored) and fill in
REM your PAT. Then point Task Scheduler at run-advisor.bat.

REM Your GitHub Personal Access Token (Contents: read & write on the repo).
set GITHUB_PAT=ghp_REPLACE_ME

REM Optional overrides (defaults shown):
REM set GITHUB_REPO=samcbarth/runmywork
REM set OLLAMA_HOST=http://127.0.0.1:11434
set OLLAMA_MODEL=llama3.1
REM set ADVISOR_FORCE=1

REM Adjust this path to wherever you cloned the repo:
node "%~dp0ai-advisor.js"
